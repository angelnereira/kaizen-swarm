#!/usr/bin/env bash
# kaizen-team: orquestador de equipo proactivo con decisiones basadas en evidencia verificada.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
[ -f "$ROOT/.kaizen/config.env" ] && . "$ROOT/.kaizen/config.env"
[ -f "$ROOT/.kaizen/team/team.env" ] && . "$ROOT/.kaizen/team/team.env"
: "${KT_FACILITATOR:=facilitador-equipo}" "${KT_VERIFIER:=verificador-evidencias}" "${KT_MONITOR:=monitor-gaceta}"
: "${KT_MIN_VERIFIED_SOURCES:=1}" "${KT_EVIDENCE_TTL_DAYS:=90}" "${KT_TASK_DUE_DAYS:=7}"
: "${KT_PAUSE_FILE:=.kaizen/loop/PAUSE}" "${KT_SOURCES_FILE:=.kaizen/org/knowledge/SOURCES.md}"
: "${KT_PROJECTS_DIR:=.kaizen/team/projects}"
PD="$ROOT/$KT_PROJECTS_DIR"; SRC="$ROOT/$KT_SOURCES_FILE"
FAIL=0
klog() { printf '[kaizen-team] %s\n' "$*"; }
kfail() { printf '[kaizen-team] FALLA: %s\n' "$*" >&2; FAIL=1; }
proj() { printf '%s/%s' "$PD" "$1"; }
proj_ok() { [ -f "$(proj "$1")/state.json" ] || { kfail "proyecto desconocido: $1"; return 1; }; }
source_ok() { local sid="$1" row; row="$(grep -F "| $sid |" "$SRC" 2>/dev/null | head -1)"; [ -n "$row" ] && printf '%s' "$row" | grep -q '| verified |'; }

cmd_init() {
  local slug="${1:?uso: init <slug> --goal T [--members a,b] [--kpi K]}" goal="" members="$KT_FACILITATOR,$KT_VERIFIER" kpi=""; shift
  while [ $# -gt 0 ]; do case "$1" in --goal) goal="$2"; shift;; --members) members="$2"; shift;; --kpi) kpi="$2"; shift;; esac; shift; done
  local d; d="$(proj "$slug")"; [ -d "$d" ] && { klog "proyecto $slug ya existe (idempotente)"; return 0; }
  mkdir -p "$d"/{standups,decisions}
  jq -n --arg slug "$slug" --arg goal "$goal" --arg kpi "$kpi" --arg facilitator "$KT_FACILITATOR" \
     --argjson members "$(printf '%s' "$members" | jq -R 'split(",")|map(gsub("^\\s+|\\s+$";""))')" \
     --arg created "$(date -u +%FT%TZ)" \
     '{slug:$slug,goal:$goal,kpi:$kpi,facilitator:$facilitator,members:$members,stage:"intake",created:$created,updated:$created}' \
     > "$d/state.json"
  printf '[]\n' > "$d/tasks.json"; : > "$d/handoffs.jsonl"
  cat > "$d/charter.md" <<EOF
# Charter: $slug

## Objetivo
${goal:-<completar>}

## KPI verificable
${kpi:-<completar>}

## Restricciones
- Decisiones con fuentes verificadas: .kaizen/team/EVIDENCIA.md
- Vetos: security, architecture, qa, compliance, scope, resource
- Proactividad con frenos: .kaizen/team/FLUJOS.md
EOF
  printf '# Blackboard: %s\n\nSolo hechos con `source_ids` verificados o salida de comando reproducible.\n\n' "$slug" > "$d/blackboard.md"
  printf '%s\n' '# Retrospectiva' '' '## Que funciono' '- ' '' '## Que no funciono' '- ' '' '## Hasta 3 mejoras (dueño, issue, fecha)' '| Mejora | Dueno | Issue | Fecha |' '| --- | --- | --- | --- |' > "$d/retro.md"
  klog "proyecto $slug inicializado en etapa intake"
}

cmd_standup() {
  local slug="$1"; proj_ok "$slug" || return 2
...
kaizen-team <comando>
  init <slug> --goal T [--members a,b] [--kpi K]   crea proyecto (intake)
