# Canales de reporte a El Presidente. Sin secretos en el repo: solo nombres de variables.
# Orden recomendado: n8n webhook -> WhatsApp Business / Telegram / correo.
KN_CHANNELS="file,webhook"

# n8n (o similar): el workflow recibe JSON y lo reenvía a WhatsApp.
# Se lee de entorno, nunca se guarda aquí. Ejemplo: export KAZEN_WEBHOOK_URL="https://n8n..."
KN_WEBHOOK_URL_VAR="KAZEN_WEBHOOK_URL"
KN_WEBHOOK_SECRET_VAR="KAZEN_WEBHOOK_SECRET"

# Correo opcional (variables de entorno: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, OWNER_EMAIL)
KN_SMTP_ENABLED=0

# Política WhatsApp (ADR-0025): solo Cloud API oficial vía BSP/n8n.
KN_WHATSAPP_MODE="bsp-cloud-webhook"
KN_WHATSAPP_WINDOW_HOURS=24
KN_WHATSAPP_OPTIN_REQUIRED=1
KN_WHATSAPP_ALLOW_UNOFFICIAL=0
KN_WHATSAPP_TEMPLATES_DIR=".kaizen/team/whatsapp/templates"

# Buzón de entrada: el agente escucha en localhost y n8n hace POST de los mensajes de WhatsApp.
KI_PORT=8787
KI_SHARED_SECRET_VAR="KAZEN_INBOX_SECRET"
KI_INBOX_DIR=".kaizen/team/inbox"
