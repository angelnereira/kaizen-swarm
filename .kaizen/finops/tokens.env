# Economía de tokens y proactividad (ADR-0021).
KT_LEDGER=".kaizen/finops/token-ledger.jsonl"
KT_REPORT="docs/kaizen/org/TOKENS.md"
KT_BASELINE_INPUT=4000          # tokens de entrada de referencia por tarea (solo estimación)
KT_BASELINE_OUTPUT=800          # tokens de salida de referencia por tarea
KT_MAX_TASKS_PER_AGENT=3        # tareas consecutivas por agente antes de reportar
KT_MAX_AGENTS=12                # techo total de agentes levantados en paralelo
KT_MAX_PARALLEL=6               # concurrencia por equipo
KT_TOKEN_CAPTURE=1              # capturar usage de `opencode run --format json`
