# Auditoria y SAST habilitados segun ADR-0035 (versiones fijadas y verificadas, S-9).
# Instalacion aislada: ~/.local/share/kaizen-swarm/sast (sin tocar paquetes del sistema).
KZ_SAST_DIR="$HOME/.local/share/kaizen-swarm/sast"

# Auditoria de dependencias de las herramientas del gate (el repo no tiene manifiesto Python).
KS_AUDIT_CMD="PYTHONPATH=$KZ_SAST_DIR python3 -m pip_audit --path $KZ_SAST_DIR"

# Analisis estatico: severidad media y alta, sin #nosec ni exclusiones.
KS_SAST_CMD="PYTHONPATH=$KZ_SAST_DIR python3 -m bandit -q -ll -r scripts/"

KS_REQUIRE_GITLEAKS=0
KS_HARDCODE_BLOCK=0
KS_MAX_REPORTS=10
