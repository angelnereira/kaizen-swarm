#!/usr/bin/env python3
"""kaizen-release: versionado, changelog, tag y release de forma verificable.

Dry-run por defecto (KZ_DRY_RUN=0 ejecuta). Nunca inventa una release si el commit
no esta en el remoto. Windows/Linux: mismo comportamiento (Python puro).
"""
import datetime, json, os, re, shlex, subprocess, sys

ROOT = os.environ.get("KAZEN_ROOT", os.getcwd())
DRY = os.environ.get("KZ_DRY_RUN", "1") != "0"
VERSION = os.path.join(ROOT, "VERSION")
CHANGELOG = os.path.join(ROOT, "CHANGELOG.md")

def sh(cmd, timeout=60):
    try:
        r = subprocess.run(cmd, shell=True, cwd=ROOT, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()
    except Exception as e:
        return 1, "", f"{type(e).__name__}: {e}"

def current():
    return open(VERSION, encoding="utf-8").read().strip() if os.path.exists(VERSION) else "0.0.0"

def bump(v):
    p = list(map(int, current().lstrip("v").split(".")))
    if v == "patch": p[2] += 1
    elif v == "minor": p[1] += 1; p[2] = 0
    elif v == "major": p[0] += 1; p[1] = 0; p[2] = 0
    elif re.match(r"^\d+\.\d+\.\d+$", v): p = list(map(int, v.split(".")))
    else:
        print("uso: kaizen-release bump patch|minor|major|X.Y.Z"); return None
    return ".".join(map(str, p))

def cmd_next():
    print(json.dumps({"current": current(), "suggested": bump("minor"),
                      "reason": "nuevas capacidades (copiloto, orquestacion, comunidad, investigacion)"},
                     ensure_ascii=False, indent=2))

def cmd_prepare(v):
    nv = bump(v)
    if not nv: return 2
    rc, head, err = sh("git rev-parse HEAD")
    rc2, remote, err2 = sh("git ls-remote origin refs/heads/$(git branch --show-current) | cut -f1")
    pushed = remote == head
    ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
    entry = f"\n## v{nv} — {ts[:10]}\n\n- Copiloto de arquitectura (8 especialistas + router) y orquestacion dinamica.\n- Comunidad de desarrollo proactiva con consenso y automejora.\n- Invocacion multi-cliente (OpenCode/Claude/Codex), investigacion externa y desbloqueo.\n- Instalacion documentada para Linux/WSL y Windows PowerShell.\n- Commit: `{head[:8]}`\n"
    if DRY:
        print(json.dumps({"dry_run": True, "version": nv, "commit": head[:8],
                          "commit_en_remoto": pushed, "tag": f"v{nv}",
                          "changelog_entry": entry.strip(), "release": "gh release create" if pushed else "BLOQUEADO: commit no pusheado"},
                         ensure_ascii=False, indent=2))
        return 0
    if not pushed:
        print("BLOQUEADO: el commit actual no esta en el remoto; haz push antes de liberar"); return 1
    open(VERSION, "w", encoding="utf-8").write(nv + "\n")
    old = open(CHANGELOG, encoding="utf-8").read() if os.path.exists(CHANGELOG) else "# Changelog\n"
    open(CHANGELOG, "w", encoding="utf-8").write(old.rstrip("\n") + "\n" + entry)
    rc3, out3, err3 = sh(f'git add VERSION CHANGELOG.md && git commit -q -m "Release v{nv}" && git tag -a v{nv} -m "v{nv}"')
    if rc3 != 0: print(f"fallo commit/tag: {err3[:300]}"); return rc3
    rc4, out4, err4 = sh(f'git push origin HEAD && git push origin v{nv}')
    if rc4 != 0: print(f"fallo push: {err4[:300]}"); return rc4
    rc5, out5, err5 = sh(f'gh release create v{nv} --title "v{nv}" --notes-file CHANGELOG.md')
    print(out5 if rc5 == 0 else f"release: {err5[:300]} (tag ya pusheado)")
    print(f"version={nv} tag=v{nv} commit={head[:8]}")
    return 0

def cmd_check():
    rc, head, _ = sh("git rev-parse HEAD")
    print(json.dumps({"version": current(), "changelog": os.path.exists(CHANGELOG),
                      "commit": head[:8], "dry_run": DRY}, ensure_ascii=False, indent=2))
    return 0

cmd = sys.argv[1] if len(sys.argv) > 1 else "check"
args = sys.argv[2:]
if cmd == "next": cmd_next()
elif cmd == "prepare":
    if not args: print("uso: kaizen-release prepare patch|minor|major|X.Y.Z"); sys.exit(2)
    sys.exit(cmd_prepare(args[0]))
elif cmd == "check": sys.exit(cmd_check())
else:
    print("uso: kaizen-release next|prepare <bump>|check"); sys.exit(2)
