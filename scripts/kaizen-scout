#!/usr/bin/env python3
"""kaizen-scout: investigacion proactiva, descubrimiento de capacidades y desbloqueo.

Delega en deep-researcher / capability-scout / task-unblocker via kaizen-invoke.
Dry-run por defecto. Ninguna investigacion autoriza instalacion ni accion externa.
"""
import json, os, shlex, subprocess, sys

ROOT = os.environ.get("KAZEN_ROOT", os.getcwd())
CLIENT = os.environ.get("KAZEN_INVOKE_CLIENT", "opencode")
DRY = os.environ.get("KZ_DRY_RUN", "1") != "0"

ROUTES = {
 "research": ("deep-researcher", "Investiga el tema con fuentes primarias, minimo 2 (1 oficial), fecha de corte y escala de confianza. Entrega guia accionable con source_ids."),
 "skills": ("capability-scout", "Descubre skills y metodos con valor real para el equipo; evaluia licencia, mantenimiento, coste y riesgo; propone POC, no instales."),
 "tools": ("capability-scout", "Descubre herramientas/MCP que doten de capacidades a los agentes; matriz adopt/pilot/defer/reject con fuente y fecha."),
 "unblock": ("task-unblocker", "Diagnostica por que la tarea esta colgada o fallo, investiga la causa real y propone correccion acotada con rollback. No ejecutes cambios sensibles."),
}

def invoke(agent, instruction, subject):
    prompt = f"{instruction}\n\nTEMA O TAREA: {' '.join(subject)}"
    cmd = [os.path.join(ROOT, "scripts/kaizen-invoke"), "invoke", CLIENT, agent, prompt]
    if DRY:
        print(json.dumps({"dry_run": True, "client": CLIENT, "agent": agent,
                          "command": shlex.join(cmd), "subject": " ".join(subject)}, ensure_ascii=False, indent=2))
        return 0
    try:
        r = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=360)
        print((r.stdout or "").strip()[-4000:])
        return r.returncode
    except Exception as e:
        print(f"error: {type(e).__name__}: {e}", file=sys.stderr); return 1

def cmd_check():
    ids = ["deep-researcher", "capability-scout", "task-unblocker"]
    missing = [i for i in ids if not os.path.exists(os.path.join(ROOT, ".kaizen/org/prompts", i + ".md"))]
    teams = json.load(open(os.path.join(ROOT, ".kaizen/team/teams.json"), encoding="utf-8"))
    inv = os.path.exists(os.path.join(ROOT, "scripts/kaizen-invoke"))
    ok = not missing and "investigacion-capacidades" in teams and inv
    print(json.dumps({"agents": len(ids), "missing": missing, "team": "investigacion-capacidades" in teams,
                      "invoke_available": inv, "client": CLIENT, "ok": bool(ok)}, ensure_ascii=False, indent=2))
    return 0 if ok else 1

cmd = sys.argv[1] if len(sys.argv) > 1 else "check"
args = sys.argv[2:]
if cmd in ROUTES:
    if not args: print(f"uso: kaizen-scout {cmd} <tema>"); sys.exit(2)
    agent, instruction = ROUTES[cmd]
    sys.exit(invoke(agent, instruction, args))
elif cmd == "check": sys.exit(cmd_check())
else:
    print("uso: kaizen-scout research|skills|tools|unblock <tema>|check"); sys.exit(2)
