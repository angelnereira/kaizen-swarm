#!/usr/bin/env bash
# grafana-bootstrap: crea el usuario/servicio de agentes en Grafana tras levantar el stack.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
[ -f "$ROOT/.kaizen/observability/observability.env" ] && . "$ROOT/.kaizen/observability/observability.env"
: "${KO_GRAFANA_PORT:=3000}" "${KO_GRAFANA_ADMIN_USER:=kaizen-admin}" "${KO_GRAFANA_ADMIN_PASSWORD:=kaizen-local}"
: "${KO_GRAFANA_AGENT_USER:=kaizen-agent}" "${KO_GRAFANA_AGENT_PASSWORD:=kaizen-agent-local}"
BASE="http://127.0.0.1:$KO_GRAFANA_PORT"
klog() { printf '[grafana-bootstrap] %s\n' "$*"; }

api() { # method path [data] — fallback controlado de lectura (ADR-0020 / #20)
  local m="$1" path="$2" data="${3:-}"
  local args=(-sS --max-time 15 -u "$KO_GRAFANA_ADMIN_USER:$KO_GRAFANA_ADMIN_PASSWORD" -H 'Content-Type: application/json' -X "$m")
  [ -n "$data" ] && args+=(-d "$data")
  curl "${args[@]}" "$BASE$path"
}

cmd_check() {
  local r; r="$(api GET /api/health 2>/dev/null || :)"
  case "$r" in *'"status":"ok"'*|*'"database":"ok"'*) klog "Grafana accesible en $BASE (usuario $KO_GRAFANA_ADMIN_USER)";; *) klog "Grafana no accesible: levanta el stack con kaizen-observability stack"; return 1;; esac
}

cmd_apply() {
  cmd_check || return 1
  local payload; payload="$(jq -cn --arg login "$KO_GRAFANA_AGENT_USER" --arg pw "$KO_GRAFANA_AGENT_PASSWORD" \
    '{name:"Kaizen Agent",email:"kaizen-agent@local",login:$login,password:$pw}')"
  local out; out="$(api POST /api/admin/users "$payload" 2>/dev/null || :)"
  case "$out" in
    *'"message"'*"User already exists"*|*"user already exists"*) klog "usuario $KO_GRAFANA_AGENT_USER ya existe";;
    *'"id"'*) klog "usuario creado: $KO_GRAFANA_AGENT_USER";;
    *) klog "no se pudo crear el usuario (revisa permisos de admin): ${out:0:120}";;
  esac
  local sa; sa="$(jq -cn --arg n "kaizen-agents" '{name:$n,role:"Viewer"}')"
  local so; so="$(api POST /api/serviceaccounts "$sa" 2>/dev/null || :)"
  case "$so" in
    *'"id"'*) local id; id="$(printf '%s' "$so" | jq -r '.id')"
      local tok; tok="$(jq -cn --arg n "kaizen-agent-token" '{name:$n,secondsToLive:0}')"
      local to; to="$(api POST "/api/serviceaccounts/$id/tokens" "$tok" 2>/dev/null || :)"
      if printf '%s' "$to" | jq -e '.key' >/dev/null 2>&1; then
        klog "service account lista; token crear en entorno, NUNCA versionar"
      else klog "service account creada; no se pudo crear token"; fi;;
    *) klog "service account ya existe o no se pudo crear";;
  esac
  klog "acceso: $BASE con $KO_GRAFANA_ADMIN_USER / (password en observability.env)"
}

case "${1:-check}" in check) cmd_check;; apply) cmd_apply;; *) echo "uso: grafana-bootstrap check|apply";; esac
