#!/usr/bin/env bash
# kaizen-whatsapp: plantillas, ventana 24h, opt-in y política oficial de WhatsApp (sin credenciales).
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
[ -f "$ROOT/.kaizen/config.env" ] && . "$ROOT/.kaizen/config.env"
KN_WHATSAPP_MODE_ENV="${KN_WHATSAPP_MODE:-}"
KAZEN_INBOX_HMAC_SECRET_ENV="${KAZEN_INBOX_HMAC_SECRET:-}"
KI_HMAC_SECRET_VAR_ENV="${KI_HMAC_SECRET_VAR:-}"
[ -f "$ROOT/.kaizen/team/notify.env" ] && . "$ROOT/.kaizen/team/notify.env"
# El entorno explícito gana sobre notify.env (C5): permite verificar la política sin credenciales.
[ -n "$KN_WHATSAPP_MODE_ENV" ] && KN_WHATSAPP_MODE="$KN_WHATSAPP_MODE_ENV"
[ -n "$KAZEN_INBOX_HMAC_SECRET_ENV" ] && KAZEN_INBOX_HMAC_SECRET="$KAZEN_INBOX_HMAC_SECRET_ENV"
[ -n "$KI_HMAC_SECRET_VAR_ENV" ] && KI_HMAC_SECRET_VAR="$KI_HMAC_SECRET_VAR_ENV"
: "${KN_WHATSAPP_WINDOW_HOURS:=24}" "${KN_WHATSAPP_OPTIN_REQUIRED:=1}" "${KN_WHATSAPP_ALLOW_UNOFFICIAL:=0}"
: "${KN_WHATSAPP_MODE:=}" "${KI_HMAC_SECRET_VAR:=KAZEN_INBOX_HMAC_SECRET}"
: "${KN_WHATSAPP_TEMPLATES_DIR:=.kaizen/team/whatsapp/templates}"
# Número de El Presidente: solo configuración local de la máquina, nunca en el repo.
OWNER_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/kaizen-swarm/owner.env"
[ -f "$OWNER_ENV" ] && . "$OWNER_ENV"
BRIDGE_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/kaizen-swarm/bridge.env"
[ -f "$BRIDGE_ENV" ] && . "$BRIDGE_ENV"  # configuracion local sensible; nunca versionada (S-1/S-2)
T="$ROOT/$KN_WHATSAPP_TEMPLATES_DIR"
# Opt-in y ventana son datos personales: SOLO en la máquina local, nunca en el repo.
W="${XDG_DATA_HOME:-$HOME/.local/share}/kaizen-swarm/whatsapp"
mkdir -p "$T" "$W"
klog() { printf '[kaizen-whatsapp] %s\n' "$*"; }

cmd_template_add() { # --id ID --category MARKETING|UTILITY|AUTHENTICATION --body T [--vars a,b]
  local id="" cat="" body="" vars=""
  while [ $# -gt 0 ]; do case "$1" in --id) id="$2"; shift;; --category) cat="$2"; shift;; --body) body="$2"; shift;; --vars) vars="$2"; shift;; esac; shift; done
  case "$cat" in MARKETING|UTILITY|AUTHENTICATION) ;; *) echo "categoría inválida"; return 2;; esac
  [ -n "$id" ] && [ -n "$body" ] || { echo "faltan --id/--body"; return 2; }
  jq -n --arg id "$id" --arg cat "$cat" --arg body "$body" --arg vars "$vars" \
    '{id:$id,category:$cat,body:$body,variables:$vars,status:"draft",note:"Requiere aprobación de Meta antes de uso proactivo"}' > "$T/$id.json"
  klog "plantilla $id creada en estado draft"
}

cmd_templates() {
  for f in "$T"/*.json; do
    [ -f "$f" ] || { echo "(sin plantillas)"; return 0; }
    printf '%s | %s | %s\n' "$(jq -r .id "$f")" "$(jq -r .category "$f")" "$(jq -r .status "$f")"
  done
}

mask_phone() { printf '%s' "numero configurado (digitos ocultos: +***)"; }

cmd_window() { # --phone N
  local phone=""; while [ $# -gt 0 ]; do case "$1" in --phone) phone="$2"; shift;; esac; shift; done
  [ -n "$phone" ] || { echo "falta --phone"; return 2; }
  local f="$W/window-$phone.json" who; who="$(mask_phone)"
  if [ ! -f "$f" ]; then echo "$who: sin interacción registrada → usa plantilla aprobada"; return 1; fi
  local last age; last="$(jq -r .last_interaction "$f")"; age=$(( ( $(date +%s) - $(date -d "$last" +%s 2>/dev/null || echo 0) ) / 3600 ))
  if [ "$age" -lt "$KN_WHATSAPP_WINDOW_HOURS" ]; then
    echo "$who: ventana abierta (${age}h < ${KN_WHATSAPP_WINDOW_HOURS}h) → mensaje libre permitido"
  else
    echo "$who: ventana cerrada (${age}h) → solo plantilla aprobada"; return 1
  fi
}

cmd_optin() { # add --phone N --source S | check --phone N
  local action="$1"; shift; local phone="" source=""
  while [ $# -gt 0 ]; do case "$1" in --phone) phone="$2"; shift;; --source) source="$2"; shift;; esac; shift; done
  [ -n "$phone" ] || { echo "falta --phone"; return 2; }
  local f="$W/optin-$phone.json" who; who="$(mask_phone)"
  if [ "$action" = add ]; then
    jq -n --arg p "$phone" --arg s "$source" --arg ts "$(date -u +%FT%TZ)" '{phone:$p,source:$s,opted_at:$ts}' > "$f"
    klog "opt-in registrado: $who ($source)"
  else
    [ -f "$f" ] || { echo "$who: SIN opt-in → no enviar"; return 1; }
    echo "$who: opt-in $(jq -r .source "$f") $(jq -r .opted_at "$f")"
  fi
}

cmd_check() {
  [ "$KN_WHATSAPP_ALLOW_UNOFFICIAL" = 0 ] || { klog "RIESGO: cliente no oficial habilitado (viola ToS, ADR-0025)"; return 1; }
  [ "$KN_WHATSAPP_OPTIN_REQUIRED" = 1 ] || { klog "RIESGO: opt-in no obligatorio"; return 1; }
  case "$KN_WHATSAPP_MODE" in bsp|official|bsp-cloud-webhook|bsp-cloud-api|cloud-api) ;; *) klog "RIESGO: modo BSP oficial no configurado (KN_WHATSAPP_MODE)"; return 1;; esac
  [ -n "${!KI_HMAC_SECRET_VAR:-}" ] || { klog "RIESGO: HMAC del buzón no configurado ($KI_HMAC_SECRET_VAR)"; return 1; }
  klog "política oficial OK: modo=$KN_WHATSAPP_MODE ventana=${KN_WHATSAPP_WINDOW_HOURS}h HMAC=configurado plantillas=$(find "$T" -name '*.json' | wc -l | tr -d ' ')"
}

cmd_owner() {
  local p="${KAZEN_OWNER_PHONE:-}"
  if [ -z "$p" ]; then echo "sin número de El Presidente en $OWNER_ENV"; return 1; fi
  local digits; digits="$(printf '%s' "$p" | tr -cd '0-9')"
  echo "propietario: configurado | numero: +*** (no se imprime)"
  [ -f "$W/optin-$digits.json" ] && echo "opt-in: SI" || echo "opt-in: NO"
}

cmd_diagnose() {
  local n names="KN_WHATSAPP_MODE KN_WEBHOOK_URL_VAR KN_WEBHOOK_SECRET_VAR KI_HMAC_SECRET_VAR KI_SHARED_SECRET_VAR"
  echo "diagnostico de canal remoto (solo presencia, sin valores):"
  for n in $names; do echo "  $n: $([ -n "${!n:-}" ] && echo configurado || echo 'NO configurado')"; done
  local wn="${KN_WEBHOOK_URL_VAR:-}" sn="${KN_WEBHOOK_SECRET_VAR:-}" hn="${KI_HMAC_SECRET_VAR:-}"
  [ -n "$wn" ] && echo "  url($wn): $([ -n "${!wn:-}" ] && echo configurado || echo 'NO configurado')"
  [ -n "$sn" ] && echo "  secreto($sn): $([ -n "${!sn:-}" ] && echo configurado || echo 'NO configurado')"
  [ -n "$hn" ] && echo "  hmac($hn): $([ -n "${!hn:-}" ] && echo configurado || echo 'NO configurado')"
  echo "buzon: $(scripts/kaizen-inbox status 2>/dev/null | head -1)"
  echo "politica: $(scripts/kaizen-whatsapp check 2>&1 | tail -1)"
}

case "${1:-check}" in
  template) shift; cmd_template_add "$@";; templates) cmd_templates;;
  owner) cmd_owner;;
  window) shift; cmd_window "$@";; optin) shift; cmd_optin "$@";; check) cmd_check;; diagnose) cmd_diagnose;;
  *) echo "uso: kaizen-whatsapp template|templates|window|optin|check|diagnose";;
esac
