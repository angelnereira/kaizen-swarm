#!/usr/bin/env python3
"""kaizen-webhook-dev: receptor LOCAL de prueba para validar el pipeline de bienvenida.

NO es n8n ni WhatsApp. Solo comprueba que kaizen-welcome construye y envia el payload
correcto. La evidencia se guarda fuera del repo, en ~/.local/share/kaizen-swarm/whatsapp/.
"""
import datetime, json, os, sys
from http.server import BaseHTTPRequestHandler, HTTPServer

OUT = os.path.expanduser("~/.local/share/kaizen-swarm/whatsapp/webhook-evidence.jsonl")
PORT = int(os.environ.get("KW_DEV_PORT", "8788"))

class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(n).decode("utf-8", "replace")
        try:
            payload = json.loads(raw)
        except Exception:
            payload = {"raw": raw[:500]}
        rec = {"received": datetime.datetime.now(datetime.timezone.utc).isoformat(),
               "path": self.path, "source_ip": self.client_address[0], "payload": payload}
        os.makedirs(os.path.dirname(OUT), exist_ok=True)
        with open(OUT, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        body = json.dumps({"ok": True, "type": payload.get("type"), "note": "webhook local de prueba"}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        print(f"[kaizen-webhook-dev] recibido {payload.get('type')} -> {OUT}", flush=True)

    def log_message(self, *_):
        pass

if __name__ == "__main__":
    print(f"[kaizen-webhook-dev] escuchando en 127.0.0.1:{PORT}/welcome (solo prueba)", flush=True)
    HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
